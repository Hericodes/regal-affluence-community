# Copy to .env.local for local development (it is git-ignored).
# Values come from Supabase → Project Settings → API.
#
# Only the public "anon" key belongs here. NEVER put the
# service_role key in this project or in GitHub variables:
# anything prefixed VITE_ is bundled into the public website.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
